# Store every text file with LF line endings in the repository. Git detects text
# files itself. The working copy uses the platform default unless a rule below sets it.
* text=auto

# Force Unix line endings for shell scripts
*.sh text eol=lf

# Force CRLF for Windows batch files
*.bat text eol=crlf

# Maven Wrapper scripts
mvnw text eol=lf
*.cmd text eol=crlf
