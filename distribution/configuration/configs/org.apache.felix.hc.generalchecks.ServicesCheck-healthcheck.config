# Health Check: Health Check Infrastructure
# Verifies that the health check executor and event admin services are registered.
# Do not list org.apache.felix.hc.api.HealthCheck here: this check is itself a
# HealthCheck service, so SCR reports a circular reference.
hc.name="Health Check Services"
hc.tags=["system","services"]
services.list=["org.apache.felix.hc.api.execution.HealthCheckExecutor","org.osgi.service.event.EventAdmin"]
